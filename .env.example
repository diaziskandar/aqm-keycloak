# ERP System - Environment Variables Template
# Copy to .env and fill in with actual values
# DO NOT commit secrets to version control!

# === Keycloak ===
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
KC_HOSTNAME=keycloak.yourdomain.com
KC_HOSTNAME_STRICT=true
KC_HOSTNAME_STRICT_HTTPS=true

# === Database ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=erp_inventory

# === API Gateway ===
API_GATEWAY_PORT=8081
SPRING_CLOUD_GATEWAY_ROUTES_0_PREDICATES_0_NAME=Path
SPRING_CLOUD_GATEWAY_ROUTES_0_PREDICATES_0_ARGS_PATTERN=/api/inventory/**
SPRING_CLOUD_GATEWAY_ROUTES_0_URI=lb://inventory-service

# === Service Discovery ===
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/
EUREKA_CLIENT_REGISTER_WITH_EUREKA=true
EUREKA_CLIENT_FETCH_REGISTRY=true

# === Logging ===
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_KENCANA=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN

# === Docker Registry ===
DOCKER_USERNAME=your_dockerhub_username
DOCKER_PASSWORD=your_dockerhub_token

# === Monitoring (Optional) ===
PROMETHEUS_PUSHGATEWAY=http://pushgateway:9091
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
